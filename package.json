{
  "name": "regne",
  "productName": "Regne",
  "version": "1.0.0",
  "description": "Regne - Mathematical CAS Document Workspace",
  "main": "dist/main/main.js",
  "scripts": {
    "brand": "node scripts/brand-electron.cjs",
    "postinstall": "node scripts/brand-electron.cjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "node scripts/brand-electron.cjs && npm run build:renderer && npm run build:main",
    "test": "npm run build:main && node test/runEngineTest.cjs",
    "start": "node scripts/brand-electron.cjs && npm run build && electron .",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json --watch",
    "dev": "node scripts/brand-electron.cjs && concurrently -k \"npm run dev:renderer\" \"npm run dev:main\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "katex": "^0.18.7",
    "lucide-react": "^1.44.0",
    "mathlive": "^0.110.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
