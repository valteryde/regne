{
  "name": "regne",
  "productName": "Regne",
  "version": "1.2.2",
  "description": "Regne - Mathematical CAS Document Workspace",
  "main": "dist/main/main.js",
  "scripts": {
    "brand": "node scripts/brand-electron.cjs",
    "postinstall": "node scripts/brand-electron.cjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json && node scripts/copy-worker.cjs",
    "build": "node scripts/brand-electron.cjs && npm run build:renderer && npm run build:main",
    "test": "npm run build:main && node test/runEngineTest.cjs",
    "start": "node scripts/brand-electron.cjs && npm run build && electron .",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json --watch",
    "dev": "node scripts/brand-electron.cjs && concurrently -k \"npm run dev:renderer\" \"npm run dev:main\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/valteryde/regne.git"
  },
  "keywords": [],
  "author": "Valter Daugberg <valteryde@usepost.dk>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "katex": "^0.18.7",
    "lucide-react": "^1.44.0",
    "mathlive": "^0.110.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.valteryde.regne",
    "icon": "resources/icon.icns",
    "publish": [
      "github"
    ],
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "src/engine/sympyWorker.py",
        "to": "engine/sympyWorker.py"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "identity": "-",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.icns",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
